# Jamra — Variables d'environnement (template)
# Copie ce fichier en .env.local et remplis avec tes vraies valeurs Supabase

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY_HERE

# Strava OAuth — https://www.strava.com/settings/api
VITE_STRAVA_CLIENT_ID=YOUR_STRAVA_CLIENT_ID

# ExerciseDB via RapidAPI — https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb
VITE_RAPIDAPI_KEY=YOUR_RAPIDAPI_KEY
